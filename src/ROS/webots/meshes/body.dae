    <effect id="Material4381-effect">
      <profile_COMMON>
        <newparam sid="PiLogoWhite_png-surface">
          <surface type="2D">
            <init_from>PiLogoWhite_png</init_from>
          </surface>
        </newparam>
        <newparam sid="PiLogoWhite_png-sampler">
          <sampler2D>
            <source>PiLogoWhite_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0.2 0.2 0.2 1</color>
            </emission>
            <diffuse>
