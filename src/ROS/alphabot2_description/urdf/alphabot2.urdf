<?xml version="1.0"?>
<robot name="alphabot2" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Colour definitions -->
    <material name="black">
        <color rgba="0.03 0.03 0.03 1.0" />
    </material>
    <material name="white">
        <color rgba="0.8 0.8 0.8 1.0" />
    </material>
    <material name="grey">
        <color rgba="0.1 0.1 0.1 1.0" />
    </material>
    <material name="blue">
        <color rgba="0.203125 0.23828125 0.28515625 1.0" />
    </material>
    <!-- * * * Link Definitions * * * -->
    <link name="bottom_plate">
        <!-- estimated as a thin aluminum plate: r=0.055 m, h=0.003 m -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.08" />
            <inertia ixx="0.00006056" ixy="0.0" ixz="0.0" iyy="0.00006056" iyz="0.0" izz="0.00012100" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.055" length="0.003" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.055" length="0.003" />
            </geometry>
        </collision>
    </link>
    <link name="body">
        <!-- estimated as a plastic box: 0.09 x 0.06 x 0.04 m, density ~1200 kg/m^3 -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.26" />
            <inertia ixx="0.00011267" ixy="0.0" ixz="0.0" iyy="0.00021017" iyz="0.0" izz="0.00025375" />
        </inertial>
        <visual>
            <geometry>
                <box size="0.09 0.06 0.04" />
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="0.09 0.06 0.04" />
            </geometry>
        </collision>
    </link>
    <link name="top_plate">
        <!-- thin plastic plate (same geometry as bottom_plate), estimated mass ~0.034 kg -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.0342" />
            <inertia ixx="0.00002590" ixy="0.0" ixz="0.0" iyy="0.00002590" iyz="0.0" izz="0.00005177" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.055" length="0.003" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.055" length="0.003" />
            </geometry>
        </collision>
    </link>
    <link name="wheelLeft">
        <!-- approximated solid wheel: r=0.022 m, L=0.025 m, mass ~0.04 kg -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.04" />
            <inertia ixx="0.0000069233" ixy="0.0" ixz="0.0" iyy="0.0000069233" iyz="0.0" izz="0.0000096800" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder radius="0.022" length="0.025" />
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder radius="0.022" length="0.025" />
            </geometry>
        </collision>
    </link>
    <link name="wheelRight">
        <!-- approximated solid wheel: r=0.022 m, L=0.025 m, mass ~0.04 kg -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.04" />
            <inertia ixx="0.0000069233" ixy="0.0" ixz="0.0" iyy="0.0000069233" iyz="0.0" izz="0.0000096800" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder radius="0.022" length="0.025" />
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0" />
            <geometry>
                <cylinder radius="0.022" length="0.025" />
            </geometry>
        </collision>
    </link>
    <link name="casterFront">
        <!-- small caster stem (plastic), very small mass -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.00094" />
            <inertia ixx="0.00000001371" ixy="0.0" ixz="0.0" iyy="0.00000001371" iyz="0.0" izz="0.00000001175" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.005" length="0.01" />
            </geometry>
            <material name="white" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.005" length="0.01" />
            </geometry>
        </collision>
    </link>
    <link name="casterBallFront">
        <!-- small spherical caster ball -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.000628" />
            <inertia ixx="0.00000000628" ixy="0.0" ixz="0.0" iyy="0.00000000628" iyz="0.0" izz="0.00000000628" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.005" />
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.005" />
            </geometry>
        </collision>
    </link>
    <link name="casterRear">
        <!-- small caster stem (plastic), very small mass -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.00094" />
            <inertia ixx="0.00000001371" ixy="0.0" ixz="0.0" iyy="0.00000001371" iyz="0.0" izz="0.00000001175" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.005" length="0.01" />
            </geometry>
            <material name="white" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.005" length="0.01" />
            </geometry>
        </collision>
    </link>
    <link name="casterBallRear">
        <!-- small spherical caster ball -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.000628" />
            <inertia ixx="0.00000000628" ixy="0.0" ixz="0.0" iyy="0.00000000628" iyz="0.0" izz="0.00000000628" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.005" />
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.005" />
            </geometry>
        </collision>
    </link>
    <!-- Body -->
    <joint name="body_joint" type="fixed">
        <origin xyz="0 0 0.0215" rpy="0 0 0" />
        <parent link="bottom_plate" />
        <child link="body" />
    </joint>
    <joint name="top_joint" type="fixed">
        <origin xyz="0 0 0.0215" rpy="0 0 0" />
        <parent link="body" />
        <child link="top_plate" />
    </joint>
    <joint name="casterFront_joint" type="fixed">
        <origin xyz="0.05 0.0 -0.0065" rpy="0 0 0" />
        <parent link="bottom_plate" />
        <child link="casterFront" />
    </joint>
    <joint name="casterBallFront_joint" type="fixed">
        <origin xyz="0.0 0.0 -0.003" rpy="0 0 0" />
        <parent link="casterFront" />
        <child link="casterBallFront" />
    </joint>
    <joint name="casterRear_joint" type="fixed">
        <origin xyz="-0.05 0.0 -0.0065" rpy="0 0 0" />
        <parent link="bottom_plate" />
        <child link="casterRear" />
    </joint>
    <joint name="casterBallRear_joint" type="fixed">
        <origin xyz="0.0 0.0 -0.003" rpy="0 0 0" />
        <parent link="casterRear" />
        <child link="casterBallRear" />
    </joint>
    <!-- Left Wheel Joint -->
    <joint name="wheelLeft_joint" type="continuous">
        <origin xyz="0.0 0.04 0.007" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <parent link="bottom_plate" />
        <child link="wheelLeft" />
        <limit effort="10000" velocity="1000" />
        <dynamics damping="1.0" friction="1.0" />
    </joint>
    <!-- Right Wheel Joint -->
    <joint name="wheelRight_joint" type="continuous">
        <origin xyz="0.0 -0.04 0.007" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <parent link="bottom_plate" />
        <child link="wheelRight" />
        <limit effort="10000" velocity="1000" />
        <dynamics damping="1.0" friction="1.0" />
    </joint>
    <!-- Gazebo plugin for ROS Control -->
    <transmission name="tranRight">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="wheelRight_joint">
            <hardwareInterface>EffortJointInterface</hardwareInterface>
        </joint>
        <actuator name="motorRight">
            <hardwareInterface>EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="tranLeft">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="wheelLeft_joint">
            <hardwareInterface>EffortJointInterface</hardwareInterface>
        </joint>
        <actuator name="motorLeft">
            <hardwareInterface>EffortJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>wheelLeft_joint</left_joint>
            <right_joint>wheelRight_joint</right_joint>
            <wheel_separation>0.07</wheel_separation>
            <wheel_radius>0.01</wheel_radius>
        </plugin>
    </gazebo>
</robot>
